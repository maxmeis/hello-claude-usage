menu "OAuth probe"
    config OAUTH_PROBE_HTTP_PORT
        int "Local settings and Wi-Fi setup HTTP port"
        range 1024 65535
        default 8080
        help
            The random, short-lived account settings and Wi-Fi setup URLs use
            this port. Their servers run separately during normal operation
            and temporary Wi-Fi provisioning.
endmenu

menu "Display diagnostics"
    config CLAUDE_DISPLAY_DIAGNOSTIC
        bool "Run raw RGB565 display test instead of the monitor"
        default n
        help
            Temporary hardware test. Bypasses LVGL, Wi-Fi and OAuth, and does
            not read or change saved credentials. Flash the normal firmware
            again to return to the monitor.
endmenu
